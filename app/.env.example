# PRD-PANTI-001 - local development environment (nonsecret values only).
# Copy to .env.local and generate the two secrets with:
#   node scripts/generate-env.mjs
# Nothing here may point at Turso Cloud, Google Drive or a remote AI provider.

APP_MODE=local-development
LOCAL_ONLY=true
APP_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

DATABASE_PROVIDER=local
DATABASE_URL=file:./var/db/panti-dev.db

STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./var/storage
BACKUP_ROOT=./var/backups

# mock | local_endpoint  (remote_endpoint is rejected while LOCAL_ONLY=true)
AI_MODE=mock
ALLOW_LOCAL_AI_ENDPOINT=false
# Comma separated, scheme://host:port, e.g. http://127.0.0.1:11434
LOCAL_AI_ALLOWED_ENDPOINTS=

LIVE_INTAKE_ENABLED=false

BETTER_AUTH_SECRET=replace-with-generated-43-char-base64url-secret
APP_ENCRYPTION_KEY=replace-with-generated-base64-32-byte-key
APP_ENCRYPTION_KEY_VERSION=1
